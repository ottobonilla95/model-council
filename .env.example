# Keys stay on this machine. You can also enter them in the app's Settings.
OPENROUTER_API_KEY=
# Optional: otherwise web search uses your OpenRouter key.
TAVILY_API_KEY=
# Optional location for the local SQLite database and saved credentials.
# PARALLAX_DATA_DIR=/absolute/path/to/private/data

# Google sign-in. Optional locally; required on Vercel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_SESSION_SECRET=
APP_BASE_URL=http://127.0.0.1:8310
PARALLAX_OWNER_EMAIL=
PARALLAX_ALLOW_SIGNUP=1
# PARALLAX_REQUIRE_AUTH=1
